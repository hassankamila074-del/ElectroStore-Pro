<!-- Created with Jaspersoft Studio version 7.0.3.final using JasperReports Library version 7.0.3-41034ca841d452f3305ba55b9042260aaa1ab5dd  -->
<jasperReport name="SalesReport" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f275f9c0-5f3e-421d-b14d-4c7a818d3087">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="electro_store_db"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="SALE_ID" class="java.lang.Integer"/>
	<query language="sql"><![CDATA[SELECT 
    s.sale_id,
    s.sale_date,
    s.subtotal,
    s.discount,
    s.total AS grand_total,
    IFNULL(c.name, 'Walk-in Customer') AS customer_name,
    IFNULL(c.phone, 'N/A') AS customer_phone,
    IFNULL(u.full_name, 'N/A') AS cashier_name,
    p.product_name,
    si.qty,
    si.unit_price,
    (si.qty * si.unit_price) AS line_total
FROM sale s
LEFT JOIN customer c ON s.customer_id = c.customer_id
LEFT JOIN app_user u ON s.user_id = u.user_id
INNER JOIN sale_item si ON s.sale_id = si.sale_id
INNER JOIN product p ON si.product_id = p.product_id
ORDER BY s.sale_id DESC
]]></query>
